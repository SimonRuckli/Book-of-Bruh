<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core packages -->
    <PackageVersion Include="CSharpFunctionalExtensions" Version="2.24.1" />

    <!-- UI packages -->
    <PackageVersion Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.39" />
    <PackageVersion Include="PropertyChanged.Fody" Version="3.4.0" />
    <PackageVersion Include="WpfAnimatedGif" Version="2.0.2" />

    <!-- Dependency Injection -->
    <PackageVersion Include="Ninject" Version="3.3.4" />

    <!-- Testing packages -->
    <PackageVersion Include="FluentAssertions" Version="6.2.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="16.11.0" />
    <PackageVersion Include="xunit" Version="2.4.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.4.3" />
    <PackageVersion Include="coverlet.collector" Version="3.1.0" />
    <PackageVersion Include="SpecFlow" Version="3.9.40" />
  </ItemGroup>
</Project>
